{
  "name": "sql-tagged-templates",
  "version": "2.2.2",
  "type": "module",
  "description": "Use tagged templates for dynamic sql",
  "main": "src/index.mjs",
  "typings": "index.d.ts",
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olsonpm/sql-tagged-templates"
  },
  "scripts": {
    "prettier-check": "prettier --check --ignore-unknown .",
    "test": "mocha \"test/**/*.js\" --exit",
    "check-markdown-links": "markdown-link-check -a 200,403 ./*.md ./docs/*.md",
    "markdown-toc": "sh ./scripts/markdown-toc.sh insert"
  },
  "keywords": [
    "mysql",
    "mysql2",
    "postgres",
    "pg",
    "prepared",
    "statements",
    "placeholder",
    "es6",
    "tagged",
    "template",
    "strings"
  ],
  "author": "Phil Olson <philip.olson@pm.me>",
  "license": "SEE LICENSE IN license.txt",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@olsonpm/markdown-toc-gen": "1.2.0-personal2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^2.8.0",
    "eslint-plugin-import-x": "^4.17.0",
    "globals": "^17.7.0",
    "markdown-link-check": "^3.14.2",
    "mocha": "^5.0.0",
    "mysql2": "^1.1.2",
    "pg": "^7.1.0",
    "prettier": "^3.8.5",
    "sequelize": "^4.0.0"
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": [
          "**/*.jsonc"
        ],
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  }
}
