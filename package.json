{
  "name": "sql-tagged-templates",
  "version": "0.1.0",
  "type": "module",
  "description": "Use tagged templates for dynamic sql",
  "main": "src/index.mjs",
  "typings": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "types": "./src/index.d.ts"
    },
    "./*": {
      "import": "./src/dialects/*.mjs",
      "types": "./src/dialects/*.d.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*.mjs"
  },
  "scripts": {
    "validate": "sh ./scripts/validate.sh",
    "test-full": "pnpm test-supported-node-versions && pnpm test-integration",
    "test-lite": "mocha 'test/*.mjs'",
    "test-supported-node-versions": "nve 22,24,26 pnpm test-lite",
    "test-integration": "mocha --parallel 'test/integration/*.mjs'",
    "coverage": "c8 --all pnpm test-lite",
    "coverage-check": "c8 --check-coverage --100 pnpm test-lite",
    "prettier-check": "prettier --check --ignore-unknown .",
    "check-markdown-links": "markdown-link-check -a 200,403 ./*.md ./docs/*.md",
    "markdown-toc": "sh ./scripts/markdown-toc.sh insert",
    "markdown-toc-check": "sh ./scripts/markdown-toc.sh check",
    "prepack": "sh ./scripts/prepack.sh",
    "postpack": "sh ./scripts/postpack.sh"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olsonpm/sql-tagged-templates"
  },
  "keywords": [
    "es6",
    "mariadb",
    "mysql",
    "mysql2",
    "pg",
    "placeholder",
    "postgres",
    "prepared",
    "sequelize",
    "statements",
    "strings",
    "tagged",
    "template"
  ],
  "author": "Phil Olson <philip.olson@pm.me>",
  "license": "SEE LICENSE IN license.txt",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@olsonpm/markdown-toc-gen": "1.2.0-personal2",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^2.8.0",
    "eslint-plugin-import-x": "^4.17.0",
    "execa": "^9.6.1",
    "globals": "^17.7.0",
    "lean-package": "^1.5.0",
    "mariadb": "^3.5.3",
    "markdown-link-check": "^3.14.2",
    "mocha": "^11.7.6",
    "monocart-coverage-reports": "^2.12.12",
    "mysql2": "^3.22.5",
    "nve": "^18.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "prettier": "^3.8.5",
    "sequelize": "^6.37.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "5.x || 6.x"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": [
          "**/*.jsonc"
        ],
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "c8": {
    "include": [
      "src/flatten-strings-and-values.mjs",
      "src/make-dialect.mjs"
    ],
    "experimental-monocart": true
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
